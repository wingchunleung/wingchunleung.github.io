  /* ── Rich phase: project title + always-on embed + foldable description ── */
  .phase-rich {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .phase-project-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: var(--weight-light);
    color: var(--color-celadon);
    letter-spacing: -0.01em;
    line-height: var(--leading-snug);
    margin: 0;
  }

  /* Artifact panel revealed when a phase is expanded */
  .phase-artifact {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .phase-embed {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    display: block;
  }

  /* Rich-phase media sits as a centered figure inside the wider essay
     column. Tufte pattern: figure ≈ 60% of surrounding text. */
  .phase-rich .phase-embed,
  .phase-rich .slide-viewer {
    max-width: 720px;
    margin-inline: auto;
  }

  .phase-embed-pdf {
    height: clamp(420px, 80vh, 760px);
  }

  .phase-embed-video {
    aspect-ratio: 16 / 9;
    height: auto;
  }

  .phase-external {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
