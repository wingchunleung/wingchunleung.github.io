---
/**
 * HCI Course Page — ARIN5301 (Prof. Xiaojuan Ma, HKUST)
 *
 * Three sections: hero → coursework (deliverables with phases) → references.
 *
 * A "deliverable" is one assignment for the course (Final Project,
 * Group Project, ...). Each deliverable is rendered as an open
 * reference-style section — hairline top divider, Cormorant display title
 * with a mono celadon eyebrow, optional 65ch intro paragraph, then a phase
 * list. No card chrome around it; embeds and future brainstorming
 * artifact strips fill the deliverable width. Layout decisions are
 * documented in design/decisions/004-hci-deliverables-reference-style.md.
 *
 * A "phase" is one submission inside a deliverable. It can carry a project
 * title, a video / PDF / slide-deck artifact, a multi-paragraph
 * description, and acknowledgments. Three render modes:
 *   - Rich phase (artifact.inline === true): the iframe / slide carousel
 *     is always visible directly in the deliverable; the description
 *     collapses to ~3 lines with a "Show more" toggle (H3 minimalist on
 *     small screens, H4 user control).
 *   - Disclosure phase (artifact present, inline !== true): native
 *     <details> keeps the artifact behind a click-to-expand row.
 *   - Static phase (no artifact): plain row with an Upcoming pill.
 *
 * The page-top TOC links to each deliverable (#assignment-{slug}) and to
 * the references section (#references) at the bottom.
 *
 * HCI principles enacted:
 * - H1 Consistency — celadon accent is the only deviation; tokens unchanged
 * - H2 Mapping — page organised by deliverable (TA's mental model)
 * - H3 Minimalism — hairlines over boxes; long descriptions truncate
 * - H4 Freedom — show-more is reversible; details disclosure is opt-in
 * - H5 Flexibility — TOC closes the execution gulf for time-pressed graders
 * - H6 Recognition — phase status pills + mono eyebrow surface state
 * - HCI-11 multimodal redundancy — colour never carries meaning alone
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

type Artifact =
  | {
      type: 'pdf' | 'video';
      src: string;                 // embed URL (used by the iframe)
      href: string;                // direct/external URL (used by "open in new tab")
      cta?: string;                // CTA wording for the disclosure variant
      inline?: boolean;            // if true, embed renders always-visible
    }
  | {
      type: 'slides';
      slides: string[];            // list of pre-rendered slide image URLs
      href: string;                // direct/external URL (PDF download fallback)
      cta?: string;
      inline?: boolean;
    };

type BrainstormObservation = {
  image: string;                   // image path
  imageAlt: string;                // alt text for accessibility
  body: string;                    // narrative paragraph (humanized)
};

type FeatureFigure = {
  image: string;                   // image path
  imageAlt: string;                // alt text (image carries words on its own)
  body?: string;                   // optional intro paragraph
  layout?: 'wide' | 'side';        // 'wide' (default) -- text above, big image below
                                   // 'side'           -- smaller image left, text right
                                   //                     (good for tall / portrait images)
};

type ProductShowcase = {
  name: string;                    // product name (alt text)
  logo: string;                    // logo image (already includes wordmark + tagline)
  demo: string;                    // demo image (UI screenshot)
  why: string;                     // "why we named it X" rationale (humanized)
  teamImage: string;               // composite headshots image (already labelled)
  brainstorming?: BrainstormObservation[]; // optional discovery / observation cards
  ideation?: BrainstormObservation[];      // optional ideate-phase artefacts (GOMS, sketches)
  prototype?: FeatureFigure;       // Prototype 1 -- single big figure with optional intro
  userFeedback?: FeatureFigure;    // User feedback for Prototype 1
  prototype2?: FeatureFigure;      // Prototype 2 -- the iteration that came out of the feedback
  userFeedback2?: FeatureFigure;   // User feedback for Prototype 2 -- round 2 of the same survey
  demoVideo?: {
    src: string;                   // embed URL (used by the iframe)
    href: string;                  // canonical YouTube URL (used by the "open" link)
    title: string;                 // iframe accessible title
  };
  slideDeck?: {                    // optional pre-rendered slide deck (carousel)
    slides: string[];              // ordered list of slide image URLs (pre-rendered from PDF)
    href: string;                  // PDF download fallback URL
    title?: string;                // optional accessible label for the carousel
  };
  contribution?: string;           // optional personal-contribution narrative (prose only)
  reflection?: string;             // optional personal-reflection narrative (prose only)
};

type Phase = {
  label: string;
  title?: string;
  projectTitle?: string;
  status: 'completed' | 'in-progress' | 'upcoming';
  note?: string;
  description?: string;            // paragraphs separated by \n\n
  acknowledgments?: string[];
  artifact?: Artifact;
  productShowcase?: ProductShowcase;
};

type Assignment = {
  slug: string;
  number: string;
  title: string;
  description?: string;            // brief assignment-level intro
  phases: Phase[];
};

const assignments: Assignment[] = [
  {
    slug: 'final-project',
    number: '02',
    title: 'Final Project (Individual)',
    phases: [
      {
        label: 'Phase 1',
        title: 'Video paper',
        projectTitle: 'The Good, the Bad, the Trade-off',
        status: 'completed',
        artifact: {
          type: 'video',
          src: 'https://drive.google.com/file/d/1pO1i1KePp4WZ-5EwFprDSA87u-MNMQMU/preview',
          href: 'https://drive.google.com/file/d/1pO1i1KePp4WZ-5EwFprDSA87u-MNMQMU/view?usp=sharing',
          inline: true,
        },
        description: [
          'Kimi Claw is a 24/7 AI assistant released in February 2026. This application is built on top of OpenClaw, with full integration into Kimi’s ecosystem (using Kimi’s AI model and cloud infrastructure). Kimi Claw aims to automate complex tasks and improve users’ efficiency. However, despite its capabilities, it comes with pros and cons. Due to time constraints, the video focuses on the user desirability aspect.',
          'In terms of pros, there are 3 main advantages. First, it offers strong automation. Users can input natural language commands, which Kimi Claw automatically translates into executable code. This eliminates the need for manual installation and implementation. Second, it is easy to set up. I recall when I set up my self-hosted OpenClaw on a virtual private server (VPS), it took me a day just to get it functional. However, Kimi Claw allows users to deploy the AI agent with just a few clicks, saving time and reducing cognitive load. Third, it has low maintenance. As OpenClaw has frequent updates, manually tracking and updating can be time-consuming. At Kimi Claw, updates are handled by the Kimi platform, and users can upgrade with a one click.',
          'Despite the above pros, there are 2 disadvantages. First, Kimi Claw violates the invisible computing principle. Unlike the original OpenClaw, Kimi Claw shows all the reasoning for each operation. While this allows users to review its current status, it becomes overwhelming over time (e.g., dozens of messages for a single operation). Second is the over-automation issue. Unlike traditional coding, where code is visible, changes using Kimi Code occur in a black box, making it unclear what is modified or whether new issues have been introduced.',
          'With that, we can see that, despite its strengths, Kimi Claw presents a trade-off -- convenience at the expense of reduced transparency and control.',
        ].join('\n\n'),
        acknowledgments: [
          'Copyright: Some images used in the video were sourced from publicly available sources via online searches (e.g., Google). All rights belong to their respective owners. This video is created for educational purposes only.',
          'AI use: The short introduction is edited by Grammarly, an AI-powered writing tool, to refine grammar and sentence structure. All suggestions were reviewed manually to preserve tone.',
        ],
      },
      {
        label: 'Phase 2',
        status: 'upcoming',
        note: 'TBD',
      },
    ],
  },
  {
    slug: 'group-project',
    number: '01',
    title: 'Group Project',
    description: 'ARIN5301 Group 5 — collaborative coursework across the term.',
    phases: [
      {
        label: 'Phase 1',
        title: 'Need-finding',
        status: 'completed',
        note: 'Slide deck presented in class',
        artifact: {
          type: 'slides',
          slides: Array.from({ length: 19 }, (_, i) =>
            `/files/group-project-slides/slide-${String(i + 1).padStart(2, '0')}.jpg`,
          ),
          href: '/files/group-project-needfinding-phase1.pdf',
          inline: true,
        },
      },
      {
        label: 'Phase 2',
        title: 'Prototype and implementation',
        status: 'completed',
        productShowcase: {
          name: 'Shepherd',
          logo: '/files/shepherd/logo.png',
          demo: '/files/shepherd/demo.png',
          why: 'A shepherd guides and protects its flock. Shepherd does the same for users -- filtering misinformation and surfacing timely guidance in everyday life.',
          teamImage: '/files/shepherd/members.png',
          brainstorming: [
            {
              image: '/files/shepherd/brainstorming/costco.png',
              imageAlt: 'Costco cafeteria with two photographed lunch boxes',
              body: "In brainstorming, my team and I focused on things and features around us that we hope to improve. This reminds me of my time at Costco (where I worked in its headquarters in the U.S., as my first full-time job out of college). At Costco, I always have lunch with my colleagues, and one of them always uses this app to track his calories by taking a picture before eating. However, I always wonder: after tracking it, so what? There is no insight -- it seems something is missing.",
            },
            {
              image: '/files/shepherd/brainstorming/fake-news.png',
              imageAlt: 'BOOM Research article on COVID-era misinformation',
              body: "Furthermore, misinformation and fake news are everywhere after COVID. This is also supported by numerous articles and research. With that, manually verifying the information is time-consuming and increases cognitive load, so my team was thinking: what if we could build something that automatically checks whether information is credible?",
            },
            {
              image: '/files/shepherd/brainstorming/smart-watch-trend.png',
              imageAlt: 'Adoption-curve chart: smartwatch (2019-2025) vs smartphone (2009-2015), first 6 years',
              body: "Lastly, after COVID, it became clear that people care much more about their personal health (which is also supported by many studies and articles). Because of this, I conducted some quick research on smartwatch adoption rates -- in just the first 6 years of adoption, smartwatches reached around 2.81 times the shipment volume of smartphones during their early adoption period. This suggests a strong public interest in personal health and self-monitoring.\n\nAt the same time, we now have many passive-tracking apps that continuously monitor health data. However, most of these apps still fail to provide truly actionable insights. This shows a gap between what users currently have and what they actually want. Therefore, my team decided to move in this direction and build Shepherd.",
            },
          ],
          ideation: [
            {
              image: '/files/shepherd/ideation/goms.png',
              imageAlt: 'GOMS framework diagram comparing current and ideal user workflows for handling raw data',
              body: "In terms of ideation, I believe the product we ultimately want to build can already be partially mimicked by some existing tools, so my team analyzed this using the GOMS framework (Goals, Operators, Methods, Selection Rules) -- to map what a user does today versus what they should have to do. The left column shows the current path, which is time-consuming, and our goal is to skip all the intermediate steps. So the assistant, (i.e., Shepherd), will automatically dive into your data and then give you actual insights, while also flagging and identifying fake information and misinformation.",
            },
            {
              image: '/files/shepherd/ideation/low-fi-prototype.png',
              imageAlt: 'Two pencil-sketched phone screens showing fake-news and calorie-nudge notifications',
              body: "From there, we also created sketches (low-fidelity drawings) to explain what we are trying to build.\n\nThe left sketch shows a fake-news notification system. When the system detects fake news while you are scrolling through social media, it will automatically send a notification flagging the content.\n\nOn the right are the actionable insights. For example, while you are scrolling through your calorie app, the system will automatically dive into your records and personal preferences, then come back with a suggestion for your next meal.",
            },
          ],
          prototype: {
            image: '/files/shepherd/prototype-1.png',
            imageAlt: 'Shepherd dashboard prototype: step count, sleep monitor, live notifications, fake-news detection panel, and calorie scanner',
            body: "With the above ideations, my team and I started implementing and completed the first prototype.",
          },
          userFeedback: {
            image: '/files/shepherd/user-feedback.png',
            imageAlt: 'Prototype 1 feedback ratings across four criteria: usefulness/value (2/5), actionability (4/5), cognitive load (2/5), trust & accuracy (4/5); pull quote "too many notifications" from a "good user"',
            body: "After implementing the 1st prototype, we interviewed 5 potential users (our friends and family members) using a short questionnaire. The average score was lower than we expected, and one of the interviewees flagged the issue of \"too many notifications.\"",
          },
          prototype2: {
            image: '/files/shepherd/prototype-2.png',
            imageAlt: 'Prototype 2 of Shepherd: a calmer two-screen view -- a Photogram social feed with an inline credibility badge, and a Health summary with a single most-watched briefing at the bottom',
            body: "With the user feedback from our 1st prototype, my team and I discussed how to resolve the users' comments and create a product that users truly love. We later agreed on an invisible computing approach (an HCI principle) -- instead of sending notifications, the system would immediately flag content and provide actionable insights on the same screen while users scroll through their phones.",
            layout: 'side',
          },
          userFeedback2: {
            image: '/files/shepherd/user-feedback-2.png',
            imageAlt: 'Prototype 2 feedback: every score moved up. Usefulness 2 to 5, actionability 4 to 5, cognitive load 2 to 5, trust & accuracy 4 to 5. The same user from round 1 now gives a thumbs-up.',
            body: "With the invisible computing approach, we conducted a 2nd interview with the same 5 users using another questionnaire (more detailed). Ultimately, the approach received an almost perfect score, showing that the users were satisfied.",
          },
          demoVideo: {
            src: 'https://www.youtube.com/embed/GWiHdHpN7lo?start=38',
            href: 'https://www.youtube.com/watch?v=GWiHdHpN7lo&t=38s',
            title: 'Shepherd demo walkthrough on YouTube',
          },
          slideDeck: {
            slides: Array.from({ length: 39 }, (_, i) =>
              `/files/shepherd/phase2-slides/slide-${String(i + 1).padStart(2, '0')}.jpg`,
            ),
            href: '/files/shepherd/making-health-data-actionable.pdf',
            title: 'Making Health Data Actionable -- Shepherd Phase 2 presentation',
          },
          contribution: "On this project, I set up the slide deck, recorded the first demo video (which we later did not use), and implemented Prototype 2. I also served as the team lead by organizing meetings, encouraging everyone to share ideas, and managing the collaboration among team members (i.e., project management).\n\nI also want to give special appreciation to Mridul, as he is very hard-working and always delivers high-quality work. He and I also spent a lot of time exchanging ideas about how to leverage HCI principles to improve the product.",
          reflection: "I believe this project is very valuable because it provided me with hands-on experience in implementing products using HCI principles. Not only was I able to practically apply HCI principles in product development, but I also gained hands-on experience in building a product through needfinding, ideation, prototyping, and more. Before taking this course, I always thought building a product meant building everything from start to end in one take. However, this course taught me the right approach -- \"build small, verify carefully.\" Also, despite all team members leveraging the same set of HCI principles when discussing product ideas, we still had different perspectives on how to address users' needs. Overall, the team project experience was enjoyable, and I learned a lot from both the course and the project.",
        },
      },
    ],
  },
].sort((a, b) => a.number.localeCompare(b.number));   // render in 01, 02, ... order

const principles = [
  {
    category: 'Usability Heuristics',
    items: [
      { name: 'Consistency', description: 'Internal, external, and metaphorical consistency across the interface.' },
      { name: 'Mapping', description: 'Match between system and real world — use language users understand.' },
      { name: 'Minimalism', description: 'Every extra element competes with relevant information.' },
      { name: 'Freedom', description: 'User control — undo, redo, emergency exits.' },
      { name: 'Flexibility', description: 'Accelerators for experts, support for novices.' },
      { name: 'Recognition', description: 'Make options visible rather than requiring recall.' },
      { name: 'Visibility', description: 'Keep users informed about system status.' },
      { name: 'Error Prevention', description: 'Prevent errors before they occur through constraints.' },
      { name: 'Error Recovery', description: 'Help users recognize, diagnose, and recover from errors.' },
      { name: 'Help', description: 'Provide help and documentation when needed.' },
    ],
  },
  {
    category: 'Gestalt Principles',
    items: [
      { name: 'Proximity', description: 'Close elements are perceived as related groups.' },
      { name: 'Similarity', description: 'Similar elements are perceived as belonging together.' },
      { name: 'Continuation', description: 'Elements on a line or curve are seen as related.' },
      { name: 'Closure', description: 'The mind completes incomplete shapes.' },
      { name: 'Figure-Ground', description: 'Users distinguish foreground from background.' },
      { name: 'Common Fate', description: 'Elements moving together are grouped.' },
      { name: 'Symmetry', description: 'Balanced elements are perceived as unified.' },
    ],
  },
  {
    category: 'Design Levels',
    items: [
      { name: 'Visceral', description: 'Immediate emotional reaction — sensation, first impression.' },
      { name: 'Behavioral', description: 'Usability and function — does it work well?' },
      { name: 'Reflective', description: 'Meaning and self-image — what does it say about me?' },
    ],
  },
];
---

<BaseLayout
  title="HCI — Wing Chun Leung"
  description="ARIN5301 Human-Computer Interaction coursework by Wing Chun Leung at HKUST."
  accent="celadon"
>
  <Header slot="header" />

  <section class="page-hero hci-hero">
    <div class="container content">
      <span class="section-label">ARIN5301</span>
      <h1>Human-Computer<br />Interaction</h1>
      <p class="page-subtitle">
        Coursework from Prof. Xiaojuan Ma's HCI course at HKUST.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       SECTION NAVIGATION (thin band, sits between hero and the first
       coursework chapter; restated as a sticky right-rail TOC at >=
       1100px so readers can navigate while scrolling).
       ═══════════════════════════════════════════════════════════════════ -->
  <section class="coursework-toc-section" aria-label="Section navigation">
    <div class="container">
      <nav class="coursework-toc" data-animate="reveal">
        <span class="coursework-toc-label section-label">Sections</span>
        <ol class="coursework-toc-list" role="list">
          {assignments.map((assignment) => (
            <li>
              <a href={`#assignment-${assignment.slug}`} class="coursework-toc-link">
                <span class="coursework-toc-num">{assignment.number}</span>
                <span class="coursework-toc-title">{assignment.title}</span>
              </a>
            </li>
          ))}
          <li>
            <a href="#references" class="coursework-toc-link">
              <span class="coursework-toc-num">03</span>
              <span class="coursework-toc-title">HCI principles</span>
            </a>
          </li>
        </ol>
      </nav>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       ASSIGNMENTS as separate banded chapters. Each renders as its own
       <section> with its own background colour so the boundaries are
       unmistakable on scroll. Order is driven by the `number` field
       (sorted in the frontmatter); first chapter sits on paper white,
       second on paper-warm, third (References) on stone. The
       `assignment-section` index is used to pick the band.
       ═══════════════════════════════════════════════════════════════════ -->
  {assignments.map((assignment, idx) => (
    <section
      id={`assignment-${assignment.slug}`}
      class:list={[
        'assignment-section',
        idx === 0 ? 'assignment-section--first' : 'assignment-section--second',
      ]}
      aria-label={assignment.title}
    >
      <div class="container">
        <article class="deliverable" data-animate="reveal">
            <header class="deliverable-header">
              <span class="deliverable-eyebrow">Deliverable {assignment.number}</span>
              <h3 class="deliverable-title">{assignment.title}</h3>
            </header>
            {assignment.description && (
              <p class="deliverable-intro">{assignment.description}</p>
            )}

            <ol class="phase-list" role="list">
              {assignment.phases.map((phase) => (
                  <li class="phase-item">
                    {phase.productShowcase ? (
                      <div class="phase phase-showcase">
                        <div class="phase-summary phase-summary-static">
                          <span class="phase-summary-main">
                            <span class="phase-num">{phase.label}</span>
                            {phase.title && <span class="phase-title">{phase.title}</span>}
                            <span class:list={['phase-status', phase.status]}>
                              {phase.status === 'completed' ? 'Completed' : phase.status === 'in-progress' ? 'In progress' : 'Upcoming'}
                            </span>
                          </span>
                        </div>

                        <div class="showcase-row">
                          <figure class="showcase-demo-pane">
                            <img
                              class="showcase-demo"
                              src={phase.productShowcase.demo}
                              alt={`${phase.productShowcase.name} interface`}
                              loading="lazy"
                            />
                          </figure>

                          <div class="showcase-why-pane">
                            <img
                              class="showcase-mark"
                              src={phase.productShowcase.logo}
                              alt={phase.productShowcase.name}
                              loading="lazy"
                            />
                            <h4 class="showcase-why-title">Why we named it {phase.productShowcase.name} 🐑</h4>
                            <p class="showcase-why-text">{phase.productShowcase.why}</p>
                          </div>
                        </div>

                        <hr class="showcase-divider" aria-hidden="true" />

                        <div class="showcase-team-block">
                          <span class="acknowledgments-label showcase-team-label">Team</span>
                          <figure class="showcase-team">
                            <img
                              src={phase.productShowcase.teamImage}
                              alt={`${phase.productShowcase.name} team`}
                              loading="lazy"
                            />
                          </figure>
                        </div>

                        {phase.productShowcase.brainstorming && phase.productShowcase.brainstorming.length > 0 && (
                          <>
                            <hr class="showcase-divider" aria-hidden="true" />

                            <div class="showcase-brainstorm-block">
                              <span class="acknowledgments-label showcase-team-label">Brainstorming</span>
                              <ol class="brainstorm-list" role="list">
                                {phase.productShowcase.brainstorming.map((obs) => (
                                  <li class="brainstorm-item">
                                    <figure class="brainstorm-figure">
                                      <button
                                        type="button"
                                        class="zoom-trigger"
                                        data-zoomable
                                        aria-haspopup="dialog"
                                        aria-label={`Enlarge image: ${obs.imageAlt}`}
                                      >
                                        <img
                                          src={obs.image}
                                          alt={obs.imageAlt}
                                          loading="lazy"
                                        />
                                        <span class="zoom-hint" aria-hidden="true">Click to enlarge</span>
                                      </button>
                                    </figure>
                                    <div class="brainstorm-body-wrap">
                                      {obs.body.split('\n\n').map((para) => (
                                        <p class="brainstorm-body">{para}</p>
                                      ))}
                                    </div>
                                  </li>
                                ))}
                              </ol>
                            </div>
                          </>
                        )}

                        {phase.productShowcase.ideation && phase.productShowcase.ideation.length > 0 && (
                          <>
                            <hr class="showcase-divider" aria-hidden="true" />

                            <div class="showcase-brainstorm-block">
                              <span class="acknowledgments-label showcase-team-label">Ideation</span>
                              <ol class="brainstorm-list" role="list">
                                {phase.productShowcase.ideation.map((obs) => (
                                  <li class="brainstorm-item">
                                    <figure class="brainstorm-figure">
                                      <button
                                        type="button"
                                        class="zoom-trigger"
                                        data-zoomable
                                        aria-haspopup="dialog"
                                        aria-label={`Enlarge image: ${obs.imageAlt}`}
                                      >
                                        <img
                                          src={obs.image}
                                          alt={obs.imageAlt}
                                          loading="lazy"
                                        />
                                        <span class="zoom-hint" aria-hidden="true">Click to enlarge</span>
                                      </button>
                                    </figure>
                                    <div class="brainstorm-body-wrap">
                                      {obs.body.split('\n\n').map((para) => (
                                        <p class="brainstorm-body">{para}</p>
                                      ))}
                                    </div>
                                  </li>
                                ))}
                              </ol>
                            </div>
                          </>
                        )}

                        {phase.productShowcase.prototype && (
                          <>
                            <hr class="showcase-divider" aria-hidden="true" />

                            <div class="showcase-feature-block">
                              <span class="acknowledgments-label showcase-team-label">Prototype 1</span>
                              {phase.productShowcase.prototype.body && (
                                <p class="showcase-feature-body">{phase.productShowcase.prototype.body}</p>
                              )}
                              <figure class="showcase-feature">
                                <button
                                  type="button"
                                  class="zoom-trigger"
                                  data-zoomable
                                  aria-haspopup="dialog"
                                  aria-label={`Enlarge image: ${phase.productShowcase.prototype.imageAlt}`}
                                >
                                  <img
                                    src={phase.productShowcase.prototype.image}
                                    alt={phase.productShowcase.prototype.imageAlt}
                                    loading="lazy"
                                  />
                                  <span class="zoom-hint" aria-hidden="true">Click to enlarge</span>
                                </button>
                              </figure>
                            </div>
                          </>
                        )}

                        {phase.productShowcase.userFeedback && (
                          <>
                            <hr class="showcase-divider" aria-hidden="true" />

                            <div class="showcase-feature-block">
                              <span class="acknowledgments-label showcase-team-label">User feedback (Prototype 1)</span>
                              {phase.productShowcase.userFeedback.body && (
                                <p class="showcase-feature-body">{phase.productShowcase.userFeedback.body}</p>
                              )}
                              <figure class="showcase-feature">
                                <button
                                  type="button"
                                  class="zoom-trigger"
                                  data-zoomable
                                  aria-haspopup="dialog"
                                  aria-label={`Enlarge image: ${phase.productShowcase.userFeedback.imageAlt}`}
                                >
                                  <img
                                    src={phase.productShowcase.userFeedback.image}
                                    alt={phase.productShowcase.userFeedback.imageAlt}
                                    loading="lazy"
                                  />
                                  <span class="zoom-hint" aria-hidden="true">Click to enlarge</span>
                                </button>
                              </figure>
                            </div>
                          </>
                        )}

                        {phase.productShowcase.prototype2 && (
                          <>
                            <hr class="showcase-divider" aria-hidden="true" />

                            <div class:list={['showcase-feature-block', { 'is-side': phase.productShowcase.prototype2.layout === 'side' }]}>
                              <span class="acknowledgments-label showcase-team-label">Prototype 2</span>
                              <figure class="showcase-feature">
                                <button
                                  type="button"
                                  class="zoom-trigger"
                                  data-zoomable
                                  aria-haspopup="dialog"
                                  aria-label={`Enlarge image: ${phase.productShowcase.prototype2.imageAlt}`}
                                >
                                  <img
                                    src={phase.productShowcase.prototype2.image}
                                    alt={phase.productShowcase.prototype2.imageAlt}
                                    loading="lazy"
                                  />
                                  <span class="zoom-hint" aria-hidden="true">Click to enlarge</span>
                                </button>
                              </figure>
                              {phase.productShowcase.prototype2.body && (
                                <p class="showcase-feature-body">{phase.productShowcase.prototype2.body}</p>
                              )}
                            </div>
                          </>
                        )}

                        {phase.productShowcase.userFeedback2 && (
                          <>
                            <hr class="showcase-divider" aria-hidden="true" />

                            <div class="showcase-feature-block">
                              <span class="acknowledgments-label showcase-team-label">User feedback (Prototype 2)</span>
                              {phase.productShowcase.userFeedback2.body && (
                                <p class="showcase-feature-body">{phase.productShowcase.userFeedback2.body}</p>
                              )}
                              <figure class="showcase-feature">
                                <button
                                  type="button"
                                  class="zoom-trigger"
                                  data-zoomable
                                  aria-haspopup="dialog"
                                  aria-label={`Enlarge image: ${phase.productShowcase.userFeedback2.imageAlt}`}
                                >
                                  <img
                                    src={phase.productShowcase.userFeedback2.image}
                                    alt={phase.productShowcase.userFeedback2.imageAlt}
                                    loading="lazy"
                                  />
                                  <span class="zoom-hint" aria-hidden="true">Click to enlarge</span>
                                </button>
                              </figure>
                            </div>
                          </>
                        )}

                        {phase.productShowcase.demoVideo && (
                          <>
                            <hr class="showcase-divider" aria-hidden="true" />

                            <div class="showcase-feature-block">
                              <span class="acknowledgments-label showcase-team-label">Demo</span>
                              <div class="showcase-video">
                                <iframe
                                  src={phase.productShowcase.demoVideo.src}
                                  title={phase.productShowcase.demoVideo.title}
                                  loading="lazy"
                                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                  allowfullscreen
                                ></iframe>
                              </div>
                              <a
                                href={phase.productShowcase.demoVideo.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="phase-external"
                              >
                                Watch on YouTube
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                  <path d="M1 11L11 1M11 1H3M11 1v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                              </a>
                            </div>
                          </>
                        )}

                        {phase.productShowcase.slideDeck && (
                          <>
                            <hr class="showcase-divider" aria-hidden="true" />

                            <div class="showcase-feature-block">
                              <span class="acknowledgments-label showcase-team-label">Slide deck</span>
                              <div
                                class="slide-viewer"
                                tabindex="0"
                                data-slide-viewer
                                data-slide-count={phase.productShowcase.slideDeck.slides.length}
                                aria-roledescription="carousel"
                                aria-label={phase.productShowcase.slideDeck.title ?? 'Slide deck'}
                              >
                                <div class="slide-viewer-stage">
                                  {phase.productShowcase.slideDeck.slides.map((src, i) => (
                                    <img
                                      class:list={['slide-viewer-slide', { 'is-current': i === 0 }]}
                                      src={src}
                                      alt={`Slide ${i + 1} of ${phase.productShowcase.slideDeck!.slides.length}`}
                                      loading={i === 0 ? 'eager' : 'lazy'}
                                      data-slide-index={i}
                                      draggable="false"
                                    />
                                  ))}
                                </div>
                                <div class="slide-viewer-controls">
                                  <button type="button" class="slide-viewer-btn" data-slide-prev aria-label="Previous slide" disabled>
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                      <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                  </button>
                                  <span class="slide-viewer-counter" data-slide-counter>1 / {phase.productShowcase.slideDeck.slides.length}</span>
                                  <button type="button" class="slide-viewer-btn" data-slide-next aria-label="Next slide">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                      <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                  </button>
                                  <span class="slide-viewer-hint">Use ← → keys</span>
                                </div>
                              </div>
                              <a
                                href={phase.productShowcase.slideDeck.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="phase-external"
                              >
                                Download PDF
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                  <path d="M1 11L11 1M11 1H3M11 1v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                              </a>
                            </div>
                          </>
                        )}

                        {phase.productShowcase.contribution && (
                          <>
                            <hr class="showcase-divider" aria-hidden="true" />

                            <div class="showcase-prose-block">
                              <span class="acknowledgments-label showcase-team-label">Contribution</span>
                              {phase.productShowcase.contribution.split('\n\n').map((para) => (
                                <p class="showcase-feature-body">{para}</p>
                              ))}
                            </div>
                          </>
                        )}

                        {phase.productShowcase.reflection && (
                          <>
                            <hr class="showcase-divider" aria-hidden="true" />

                            <div class="showcase-prose-block">
                              <span class="acknowledgments-label showcase-team-label">Reflection</span>
                              {phase.productShowcase.reflection.split('\n\n').map((para) => (
                                <p class="showcase-feature-body">{para}</p>
                              ))}
                            </div>
                          </>
                        )}
                      </div>
                    ) : phase.artifact?.inline ? (
                      <div class="phase phase-rich">
                        <div class="phase-summary phase-summary-static">
                          <span class="phase-summary-main">
                            <span class="phase-num">{phase.label}</span>
                            {phase.title && <span class="phase-title">{phase.title}</span>}
                            <span class:list={['phase-status', phase.status]}>
                              {phase.status === 'completed' ? 'Completed' : phase.status === 'in-progress' ? 'In progress' : 'Upcoming'}
                            </span>
                          </span>
                        </div>

                        {phase.projectTitle && (
                          <p class="phase-project-title">{phase.projectTitle}</p>
                        )}

                        {phase.artifact.type === 'video' && (
                          <iframe
                            class="phase-embed phase-embed-video"
                            src={phase.artifact.src}
                            title={`${phase.label}${phase.projectTitle ? ': ' + phase.projectTitle : ''}`}
                            loading="lazy"
                            allow="autoplay; fullscreen"
                            allowfullscreen
                          ></iframe>
                        )}

                        {phase.artifact.type === 'pdf' && (
                          <iframe
                            class="phase-embed phase-embed-pdf"
                            src={phase.artifact.src}
                            title={`${phase.label}${phase.projectTitle ? ': ' + phase.projectTitle : ''}`}
                            loading="lazy"
                          ></iframe>
                        )}

                        {phase.artifact.type === 'slides' && (
                          <div
                            class="slide-viewer"
                            tabindex="0"
                            data-slide-viewer
                            data-slide-count={phase.artifact.slides.length}
                            aria-roledescription="carousel"
                            aria-label={`${assignment.title} — ${phase.label}${phase.title ? ': ' + phase.title : ''}`}
                          >
                            <div class="slide-viewer-stage">
                              {phase.artifact.slides.map((src, i) => (
                                <img
                                  class:list={['slide-viewer-slide', { 'is-current': i === 0 }]}
                                  src={src}
                                  alt={`Slide ${i + 1} of ${phase.artifact.slides.length}`}
                                  loading={i === 0 ? 'eager' : 'lazy'}
                                  data-slide-index={i}
                                  draggable="false"
                                />
                              ))}
                            </div>
                            <div class="slide-viewer-controls">
                              <button type="button" class="slide-viewer-btn" data-slide-prev aria-label="Previous slide" disabled>
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                  <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                              </button>
                              <span class="slide-viewer-counter" data-slide-counter>1 / {phase.artifact.slides.length}</span>
                              <button type="button" class="slide-viewer-btn" data-slide-next aria-label="Next slide">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                  <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                              </button>
                              <span class="slide-viewer-hint">Use ← → keys</span>
                            </div>
                          </div>
                        )}

                        <a href={phase.artifact.href} target="_blank" rel="noopener noreferrer" class="phase-external">
                          {phase.artifact.type === 'slides' ? 'Download PDF' : 'Open in new tab'}
                          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <path d="M1 11L11 1M11 1H3M11 1v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </a>

                        {phase.description && (
                          <div class="description-clip" data-expanded="false">
                            <div class="description-body">
                              {phase.description.split('\n\n').map((para) => (
                                <p class="description-para">{para}</p>
                              ))}
                            </div>
                            <button
                              type="button"
                              class="description-toggle"
                              aria-expanded="false"
                              data-toggle-description
                            >
                              <span class="description-toggle-label">Show more</span>
                              <svg class="description-toggle-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </button>
                          </div>
                        )}

                        {phase.acknowledgments && phase.acknowledgments.length > 0 && (
                          <div class="phase-acknowledgments">
                            <span class="acknowledgments-label">Acknowledgments</span>
                            {phase.acknowledgments.map((line) => (
                              <p class="acknowledgments-line">{line}</p>
                            ))}
                          </div>
                        )}
                      </div>
                    ) : phase.artifact ? (
                      <details class="phase">
                        <summary class="phase-summary">
                          <span class="phase-summary-main">
                            <span class="phase-num">{phase.label}</span>
                            {phase.title && <span class="phase-title">{phase.title}</span>}
                            <span class:list={['phase-status', phase.status]}>
                              {phase.status === 'completed' ? 'Completed' : phase.status === 'in-progress' ? 'In progress' : 'Upcoming'}
                            </span>
                          </span>
                          {phase.note && <span class="phase-note">{phase.note}</span>}
                          <span class="phase-cta">
                            <span>{phase.artifact.cta ?? 'View'}</span>
                            <span class="phase-arrow" aria-hidden="true">
                              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                <path d="M3 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </span>
                          </span>
                        </summary>
                        <div class="phase-artifact">
                          {phase.artifact.type === 'pdf' ? (
                            <iframe
                              class="phase-embed phase-embed-pdf"
                              src={phase.artifact.src}
                              title={`${assignment.title} — ${phase.label}${phase.title ? ': ' + phase.title : ''}`}
                              loading="lazy"
                            ></iframe>
                          ) : (
                            <iframe
                              class="phase-embed phase-embed-video"
                              src={phase.artifact.src}
                              title={`${assignment.title} — ${phase.label}${phase.title ? ': ' + phase.title : ''}`}
                              loading="lazy"
                              allow="autoplay; fullscreen"
                              allowfullscreen
                            ></iframe>
                          )}
                          <a href={phase.artifact.href} target="_blank" rel="noopener noreferrer" class="phase-external">
                            Open in new tab
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                              <path d="M1 11L11 1M11 1H3M11 1v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </a>
                        </div>
                      </details>
                    ) : (
                      <div class="phase phase-static">
                        <span class="phase-summary-main">
                          <span class="phase-num">{phase.label}</span>
                          {phase.title && <span class="phase-title">{phase.title}</span>}
                          <span class:list={['phase-status', phase.status]}>
                            {phase.status === 'completed' ? 'Completed' : phase.status === 'in-progress' ? 'In progress' : 'Upcoming'}
                          </span>
                        </span>
                        {phase.note && <span class="phase-note">{phase.note}</span>}
                      </div>
                    )}
                  </li>
                ))}
              </ol>
          </article>
        </div>
      </section>
    ))}

  <!-- ═══════════════════════════════════════════════════════════════════
       REFERENCES — HCI principles that shaped the deliverables
       Gestalt: Proximity + Similarity; Miller's ~7 — each cap ≤10 items
       ═══════════════════════════════════════════════════════════════════ -->
  <section id="references" class="references-section" aria-labelledby="references-heading">
    <div class="container">
      <div class="content">
        <span class="section-label">Applied</span>
        <h2 id="references-heading">HCI principles I leveraged</h2>
      </div>

      <div class="principles-grid">
        {principles.map((group) => (
          <div class="principle-group" data-animate="reveal">
            <h3 class="group-title">{group.category}</h3>
            <ul class="principle-list">
              {group.items.map((item) => (
                <li class="principle-item">
                  <span class="principle-name">{item.name}</span>
                  <span class="principle-desc">{item.description}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       LIGHTBOX -- single instance for click-to-enlarge on any
       [data-zoomable] trigger. Native <dialog>.showModal() handles focus
       trap, inert background, Esc-to-close, and aria-modal implicitly.
       ═══════════════════════════════════════════════════════════════════ -->
  <dialog id="lightbox" class="lightbox" aria-labelledby="lightbox-caption">
    <button type="button" class="lightbox-close" aria-label="Close enlarged image">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M5 5l10 10M15 5l-10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
    <img class="lightbox-img" alt="" />
    <p id="lightbox-caption" class="lightbox-caption"></p>
  </dialog>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* HCI page uses celadon accent */
  .hci-hero {
    background: var(--color-surface);
  }

  .page-hero {
    padding-top: calc(72px + var(--section-gap));
    padding-bottom: var(--space-8);
  }

  .page-hero .section-label {
    opacity: 0;
    transform: translateY(20px);
    animation: pageReveal 0.8s var(--ease-out) 0.2s forwards;
  }

  .page-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
    opacity: 0;
    transform: translateY(30px);
    animation: pageReveal 0.8s var(--ease-out) 0.4s forwards;
    background: linear-gradient(135deg, var(--color-ink) 0%, var(--color-celadon) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    max-width: 55ch;
    opacity: 0;
    transform: translateY(20px);
    animation: pageReveal 0.8s var(--ease-out) 0.6s forwards;
  }

  @keyframes pageReveal {
    to { opacity: 1; transform: translateY(0); }
  }

  .section-header {
    margin-bottom: var(--space-5);
    opacity: 0; transform: translateY(30px);
  }
  .section-header.visible {
    opacity: 1; transform: translateY(0);
    transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
  }
  .section-header h2 { margin-top: var(--space-2); }

  /* ── Coursework: thin TOC band between hero and the first chapter.
        Just the section navigation lives here; no h2, no padding-heavy
        chrome. The chapter sections below carry the visual weight. */
  .coursework-toc-section {
    padding: var(--space-6) 0 var(--space-5);
  }

  /* ── Assignment chapters: each deliverable renders as its own banded
        <section> so the boundaries are unmissable on scroll. Per long-
        form research (Stripe Press / Linear / Distill), banding works
        when bands correspond to meaningful semantic units, use 2-3
        muted neutrals only, and shift at most 3-5 times per page. The
        compound chapter signal here = bg shift + 160-192px top padding
        + the existing Cormorant deliverable-title acting as the H2. */
  .assignment-section {
    padding: clamp(120px, 14vw, 192px) 0;
    scroll-margin-top: 96px;
  }

  .assignment-section--first {
    background: var(--color-paper);            /* white */
  }

  .assignment-section--second {
    background: var(--color-paper-warm);       /* #faf9f7 */
  }

  /* ── Deliverable: lives inside an assignment-section now, so the old
        top-hairline + 96px padding (used to stack two deliverables in
        one column) is no longer needed -- each deliverable is the only
        child of its container. The section's own padding does the
        breathing room. */
  .deliverable {
    scroll-margin-top: 96px;
    opacity: 0;
    transform: translateY(30px);
  }

  .deliverable.visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--duration-reveal) var(--ease-out),
                transform var(--duration-reveal) var(--ease-out);
  }

  .deliverable-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .deliverable-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-celadon);
    font-weight: var(--weight-medium);
  }

  /* Deliverable title is now the chapter heading -- promoted in size
     to match the chapter weight (Stripe Press / Linear pattern).
     Still uses Cormorant Light + tight tracking for the "ink wash"
     register. */
  .deliverable-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: var(--weight-light);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0;
  }

  .deliverable-intro {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-5);
    max-width: 65ch;
  }

  /* Artifact strip — full-width gallery for brainstorming photos / sketches.
     Drop a <div class="artifact-strip"> inside a deliverable when you want
     figures to break out of the prose column and fill the deliverable width.
     Each <figure class="artifact-figure"> renders as image + mono caption. */
  .artifact-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }

  .artifact-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .artifact-figure img {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    display: block;
  }

  .artifact-figure figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-wide);
    color: var(--color-wash);
    line-height: var(--leading-normal);
  }

  /* Phase list — one row per phase, hairline-separated inside a deliverable */
  .phase-list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .phase-item + .phase-item {
    border-top: 1px solid var(--color-border);
  }

  .phase {
    padding: var(--space-4) 0;
  }

  .phase-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .phase-summary-static {
    cursor: default;
    user-select: auto;
  }

  /* Hide the default disclosure marker — we render our own arrow */
  .phase-summary::-webkit-details-marker { display: none; }
  .phase-summary::marker { content: ''; display: none; }

  .phase-summary-main {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .phase-num {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-celadon);
    font-weight: var(--weight-medium);
  }

  .phase-title {
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .phase-status {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .phase-status.completed {
    color: var(--color-celadon);
    background: rgba(125, 158, 140, 0.12);
  }

  .phase-status.upcoming {
    color: var(--color-wash);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  /* In-progress sits between Done and Upcoming. Dashed border + tinted bg
     reads as "started, not finished" without inventing a new colour. */
  .phase-status.in-progress {
    color: var(--color-celadon);
    background: rgba(125, 158, 140, 0.06);
    border: 1px dashed var(--color-celadon);
  }

  .phase-note {
    font-size: var(--text-small);
    color: var(--color-wash);
    flex: 1 1 12rem;
    min-width: 0;
  }

  .phase-cta {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--color-celadon);
    flex-shrink: 0;
  }

  .phase-arrow {
    display: inline-flex;
    align-items: center;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  details[open] > .phase-summary .phase-arrow {
    transform: rotate(90deg);
  }

  .phase-summary:hover .phase-cta {
    color: var(--color-ink);
  }

  /* Static (non-interactive) phase row */
  .phase-static {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    color: var(--color-wash);
  }

  /* ── Rich phase: project title + always-on embed + foldable description ── */
  .phase-rich {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .phase-project-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: var(--weight-light);
    color: var(--color-celadon);
    letter-spacing: -0.01em;
    line-height: var(--leading-snug);
    margin: 0;
  }

  /* Artifact panel revealed when a phase is expanded */
  .phase-artifact {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .phase-embed {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    display: block;
  }

  /* Rich-phase media sits as a centered figure inside the wider essay
     column. Tufte pattern: figure ≈ 60% of surrounding text. The same
     720px cap applies to slide-viewers inside any showcase-feature
     block (Phase 2 slide deck) so the two carousels read at matching
     scale across the page. */
  .phase-rich .phase-embed,
  .phase-rich .slide-viewer,
  .showcase-feature-block .slide-viewer {
    max-width: 720px;
    margin-inline: auto;
  }

  .phase-embed-pdf {
    height: clamp(420px, 80vh, 760px);
  }

  .phase-embed-video {
    aspect-ratio: 16 / 9;
    height: auto;
  }

  .phase-external {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--color-celadon);
  }

  .phase-rich .phase-external {
    align-self: center;
  }

  .phase-external::after { display: none; }

  .phase-external:hover {
    color: var(--color-ink);
  }

  /* ── Slide viewer ─────────────────────────────────────────────────────
     Pre-rendered slide images, navigated by buttons or arrow keys when
     the viewer holds focus. Lazy-loads beyond the first slide. */

  .slide-viewer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    outline: none;
  }

  .slide-viewer:focus-visible {
    outline: 2px solid var(--color-celadon);
    outline-offset: 4px;
    border-radius: var(--radius-md);
  }

  .slide-viewer-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .slide-viewer-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out);
    pointer-events: none;
    user-select: none;
  }

  .slide-viewer-slide.is-current {
    opacity: 1;
  }

  .slide-viewer-controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .slide-viewer-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-celadon);
    cursor: pointer;
    transition: border-color var(--duration-normal) var(--ease-out),
                color var(--duration-normal) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }

  .slide-viewer-btn:hover:not(:disabled) {
    border-color: var(--color-celadon);
    color: var(--color-ink);
    transform: translateY(-1px);
  }

  .slide-viewer-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .slide-viewer-counter {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-wider);
    color: var(--color-wash);
    min-width: 4ch;
    text-align: center;
  }

  .slide-viewer-hint {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-wash);
    margin-left: auto;
    opacity: 0.6;
  }

  @media (max-width: 480px) {
    .slide-viewer-hint { display: none; }
  }

  /* ── Description clip / show-more pattern ───────────────────────────── */
  /* Description spans the full deliverable width — user chose the whole
     horizontal span over the Tufte 80ch cap. At a 1200px container the
     line measure is wider than the comprehension-safe range; that
     trade-off is intentional, accepted in DDR-004 §10. */
  .description-clip {
    margin-top: var(--space-3);
  }

  .description-body {
    /* 3 lines at the wider line-height (1.85). Recomputed in iteration 3
       when line-height bumped from 1.7 to 1.85 — see DDR-004 §11. */
    max-height: 5.55em;
    overflow: hidden;
    position: relative;
  }

  .description-clip[data-expanded="true"] .description-body {
    max-height: none;
  }

  .description-body::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 2.4em;
    background: linear-gradient(to bottom, transparent, var(--color-bg));
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .description-clip[data-expanded="true"] .description-body::after {
    opacity: 0;
  }

  /* Wide-line typography compensation. When prose flows past the
     comprehension-safe measure (~80ch), three things break unless
     compensated: leading is too tight, low-contrast text becomes
     untrackable, and rivers form on Inter. The override below addresses
     all three — see DDR-004 §11 for sources (Bringhurst, Butterick, WCAG
     1.4.12, WebAIM). The `max-width: none` is required to defeat the
     global `p { max-width: 65ch }` rule in styles/global.css. */
  .description-para {
    font-size: var(--text-small);
    color: var(--color-ink-soft);
    line-height: 1.85;
    word-spacing: 0.03em;
    margin: 0;
    max-width: none;
  }

  .description-para + .description-para {
    margin-top: 1.5em;
  }

  .description-toggle {
    background: none;
    border: none;
    padding: var(--space-2) 0 0;
    margin: 0;
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-celadon);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .description-toggle:hover {
    color: var(--color-ink);
  }

  .description-toggle-arrow {
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .description-clip[data-expanded="true"] .description-toggle-arrow {
    transform: rotate(180deg);
  }

  /* ── Phase-level acknowledgments — centered colophon at the tail ────── */
  /* Film-credits register: centered, hairline above, no card chrome.
     Mono uppercase label + small wash-grey lines. */
  .phase-acknowledgments {
    margin: var(--space-5) auto 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    max-width: 56ch;
    text-align: center;
  }

  .acknowledgments-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-wash);
    margin-bottom: var(--space-2);
  }

  .acknowledgments-line {
    font-size: var(--text-caption);
    color: var(--color-wash);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .acknowledgments-line + .acknowledgments-line {
    margin-top: var(--space-2);
  }

  /* ── Phase product showcase ─────────────────────────────────────────
     Slide-deck composition: demo screenshots (left) + Shepherd panel
     (right) sit side-by-side; the team image runs as a strip below.
     On mobile the row stacks. */
  .phase-showcase {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  .showcase-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    align-items: center;
  }

  @media (max-width: 768px) {
    .showcase-row {
      grid-template-columns: 1fr;
    }
  }

  .showcase-demo-pane {
    margin: 0;
  }

  /* Demo image already carries phone bezels; no extra border or radius. */
  .showcase-demo {
    width: 100%;
    height: auto;
    display: block;
  }

  .showcase-why-pane {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-self: center;
  }

  /* Logo lockup at the top of the right pane. */
  .showcase-mark {
    max-width: 280px;
    width: 100%;
    height: auto;
    display: block;
  }

  .showcase-why-title {
    font-family: var(--font-body);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    line-height: var(--leading-snug);
    margin: var(--space-3) 0 0;
  }

  /* Why-prose -- shorter measure than the description-para since this is
     a panel, not a body column. Soft ink for comfortable reading. */
  .showcase-why-text {
    font-size: var(--text-body);
    color: var(--color-ink-soft);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 50ch;
  }

  /* Short centered solid hairline -- a Tufte sub-section break. Reads
     as "minor" relative to the full-width solid hairlines that mark
     phase boundaries. Per Butterick, single solid is the only defensible
     rule style; dashed reads as draft / coupon-cut and conflicts with
     the dashed in-progress pill on this same page (which means
     "incomplete," not "section break"). Used above the Team block and
     above the Brainstorming block. */
  .showcase-divider {
    width: 64px;
    height: 0;
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: var(--space-6) auto;
  }

  /* Brainstorming sub-section -- alternating image / text rows. Image
     in the narrower (5fr) column, body in the wider (7fr) column. Per
     the user's brief: text leads, image supports. No inter-observation
     dividers (the short hairline is reserved for between-section
     breaks). Row separation is Gestalt proximity: 96px between rows
     vs 48px within a row -- 2:1 ratio reads as "different observation"
     without a rule. Source DOM order is image-then-text on every row;
     :nth-child(even) reorders into the grid for visual variety while
     keeping the semantic / a11y order stable. */
  .showcase-brainstorm-block {
    margin: 0 auto;
    max-width: 1100px;
  }

  .brainstorm-list {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: grid;
    gap: var(--space-8);
  }

  /* Reverted to text-dominant 5fr 7fr after user found 1fr 1fr made the
     overall section too long. Smaller images are paired with a click-
     to-enlarge lightbox so in-image labels stay readable on demand
     without occupying scroll real estate by default. */
  .brainstorm-item {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-6);
    align-items: start;
  }

  .brainstorm-item:nth-child(even) {
    grid-template-columns: 7fr 5fr;
  }

  .brainstorm-item:nth-child(even) .brainstorm-figure {
    grid-column: 2;
    grid-row: 1;
  }

  @media (max-width: 768px) {
    .brainstorm-item,
    .brainstorm-item:nth-child(even) {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .brainstorm-item:nth-child(even) .brainstorm-figure {
      grid-column: 1;
      grid-row: auto;
    }
  }

  .brainstorm-figure {
    margin: 0;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 360px ceiling -- the smaller default that keeps the section
     compact. Click-to-enlarge lightbox handles the case where
     in-image labels need to be read at full size. */
  .brainstorm-figure img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: contain;
  }

  /* Body sized for "deep-dive" presence. Per Butterick + Bringhurst,
     17-19px Inter at 1.7 leading lands in the comfort band when the
     measure is ~70ch; the slight letter-spacing tighten compensates
     for Inter's open default at this size. Soft ink (--color-ink-soft)
     keeps long reading comfortable -- full ink reads harsh at length. */
  .brainstorm-body {
    font-size: 1rem;
    line-height: var(--leading-relaxed);
    letter-spacing: -0.005em;
    color: var(--color-ink-soft);
    margin: 0;
    max-width: none;
  }

  /* Paragraph spacing when a brainstorm-body has multiple paragraphs
     (split on \n\n in the data). Matches the description-para rhythm
     so multi-paragraph entries read with consistent breathing. */
  .brainstorm-body + .brainstorm-body {
    margin-top: 1.25em;
  }

  /* Single-figure sub-section (Prototype, User feedback). The image
     itself carries the words, so no body prose. Bigger than the
     brainstorming-row figures because the user said these are the
     important moments. Same wash-grey eyebrow label as the other
     sub-sections; same hairline frame as the brainstorming figures. */
  .showcase-feature-block {
    margin: 0 auto;
    max-width: 1100px;
    width: 100%;          /* ← must be explicit. Without it, when the
                             child has no intrinsic width (the video
                             wrapper uses position-absolute children +
                             padding-bottom to fake an aspect ratio),
                             the block collapses to the width of the
                             label and link, and the iframe shrinks. */
  }

  .showcase-feature {
    margin: var(--space-4) 0 0;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .showcase-feature img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Demo video -- 16:9 YouTube embed sized to match the screenshot
     figures above. Uses padding-bottom hack (instead of aspect-ratio
     property) because it forces the wrapper to its computed height
     regardless of the iframe's intrinsic dimensions. The wrapper
     grows the showcase-feature-block to the full container width
     (1200px) so the demo doesn't read as smaller than the prototype
     and feedback images above it. */
  /* Demo block runs to the full container width so the video reads
     as the largest figure on the page (it is the culmination). */
  .showcase-feature-block:has(.showcase-video) {
    max-width: var(--max-container);
    width: 100%;
  }

  .showcase-video {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;          /* 9 / 16 = 0.5625 -- forces 16:9 height */
    margin: var(--space-3) 0;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .showcase-video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Center the "Watch on YouTube" link under the video, matching the
     centered video-paper external link in the rich phase. */
  .showcase-feature-block > .phase-external {
    align-self: center;
    margin-inline: auto;
  }

  /* Intro paragraph above a single-figure sub-section. Same prose
     register as .brainstorm-body. No max-width cap so the paragraph
     fills the wrapper width (1100px) instead of sitting on the left
     half. Soft ink for comfortable reading. */
  .showcase-feature-body {
    font-size: 1rem;
    line-height: var(--leading-relaxed);
    letter-spacing: -0.005em;
    color: var(--color-ink-soft);
    margin: var(--space-3) 0 0;
    max-width: none;
  }

  /* Multi-paragraph spacing for prose blocks (Contribution / Reflection
     when the body string contains \n\n). Same rhythm as brainstorm-body. */
  .showcase-feature-body + .showcase-feature-body {
    margin-top: 1.25em;
  }

  /* Prose-only sub-section (Contribution, Reflection). Matches the
     1100px wrapper of the showcase-feature-blocks above so the label
     sits at the same horizontal position as the SLIDE DECK / DEMO /
     PROTOTYPE labels -- the page reads as a single column of
     consistently-aligned sub-sections rather than a step-down at the
     tail. The body inside still uses the wide-line typography
     compensation (soft ink, 1.7 leading, word-spacing) so the longer
     measure stays readable. */
  .showcase-prose-block {
    margin: 0 auto;
    max-width: 1100px;
    width: 100%;
  }

  /* Side-by-side variant -- for tall / portrait images where a full-
     width treatment would dwarf the page. Image (~600px) sits left,
     body text fills the remaining ~470px on the right. Bumped from
     360px after user found in-image text (phone-screenshot UI labels)
     was too small. The label spans both columns at the top. Mobile
     collapses to stack: label, image, body. */
  .showcase-feature-block.is-side {
    display: grid;
    grid-template-columns: 600px 1fr;
    grid-template-areas:
      "label  label"
      "figure body";
    column-gap: var(--space-5);
    row-gap: var(--space-3);
    align-items: start;
  }

  .showcase-feature-block.is-side > .acknowledgments-label {
    grid-area: label;
  }

  .showcase-feature-block.is-side > .showcase-feature {
    grid-area: figure;
    margin: 0;
    max-width: 100%;
  }

  .showcase-feature-block.is-side > .showcase-feature-body {
    grid-area: body;
    margin: 0;
    align-self: center;
  }

  @media (max-width: 768px) {
    .showcase-feature-block.is-side {
      grid-template-columns: 1fr;
      grid-template-areas:
        "label"
        "figure"
        "body";
    }
  }

  /* Team strip -- image already labels each face. The divider above
     handles the section break; the wrapper owns the strip's own
     spacing and width. */
  .showcase-team-block {
    margin: 0 auto;
    max-width: 880px;
  }

  .showcase-team-label {
    margin-bottom: var(--space-3);
    text-align: center;
    font-size: 1.0625rem;  /* 17px, scaled up for sub-section eyebrow weight */
  }

  .showcase-team {
    margin: 0;
    width: 100%;
  }

  .showcase-team img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Coursework TOC — calm, two-hairline reference-page register */
  .coursework-toc {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-3);
    margin-bottom: var(--space-8);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .coursework-toc-label {
    flex-shrink: 0;
  }

  .coursework-toc-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: 0;
  }

  .coursework-toc-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: var(--weight-light);
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    text-decoration: none;
    padding: var(--space-1) 0;
    transition: color var(--duration-normal) var(--ease-out);
    scroll-margin-top: 96px;
  }

  .coursework-toc-link::after { display: none; }

  .coursework-toc-link:hover {
    color: var(--color-celadon);
  }

  .coursework-toc-num {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-wider);
    color: var(--color-celadon);
    font-weight: var(--weight-medium);
  }

  /* References — HCI principles that shaped the deliverables */
  .references-section {
    padding: var(--section-gap) 0;
    background: var(--color-surface);
    scroll-margin-top: 96px;
  }

  .references-section h2 {
    margin-top: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    max-width: var(--max-container);
  }

  @media (min-width: 768px) {
    .principles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .principle-group {
    opacity: 0;
    transform: translateY(30px);
  }

  .principle-group.visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--duration-reveal) var(--ease-out),
                transform var(--duration-reveal) var(--ease-out);
  }

  .group-title {
    font-size: var(--text-h3);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .principle-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .principle-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    transition: background var(--duration-normal) var(--ease-out);
  }

  .principle-item:hover {
    background: rgba(125, 158, 140, 0.06);
  }

  .principle-name {
    font-weight: var(--weight-medium);
    font-size: var(--text-small);
    color: var(--color-celadon);
  }

  .principle-desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  /* ── Zoom-trigger + lightbox ─────────────────────────────────────────
     Pattern: any image inside a [data-zoomable] button gets a hover hint
     ("CLICK TO ENLARGE") and a zoom-in cursor. Activating the button
     opens the page-level <dialog id="lightbox">. Native <dialog> +
     showModal() handles focus trap, inert background, Esc, ARIA. */
  .zoom-trigger {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    position: relative;
    width: 100%;
    border-radius: var(--radius-md);
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .zoom-trigger:hover {
    transform: translateY(-2px);
  }

  .zoom-trigger:focus-visible {
    outline: 2px solid var(--color-celadon);
    outline-offset: 4px;
  }

  /* Mono "CLICK TO ENLARGE" pill, bottom-right of the figure, fades in
     on hover/focus only (touch falls back to the button affordance).
     Sized small -- a hint, not a stamp. */
  .zoom-hint {
    position: absolute;
    bottom: var(--space-2);
    right: var(--space-2);
    padding: 1px 5px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.4375rem;
    font-weight: var(--weight-regular);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-celadon);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity var(--duration-normal) var(--ease-out),
                transform var(--duration-normal) var(--ease-out);
    pointer-events: none;
  }

  .zoom-trigger:hover .zoom-hint,
  .zoom-trigger:focus-visible .zoom-hint {
    opacity: 1;
    transform: translateY(0);
  }

  /* Lightbox dialog -- single instance for the whole page */
  .lightbox {
    border: 0;
    padding: var(--space-4);
    background: var(--color-bg);
    border-radius: var(--radius-md);
    max-width: min(95vw, 1400px);
    max-height: 90vh;
    color: var(--color-ink);
    box-shadow: 0 20px 60px rgba(29, 29, 31, 0.18);
    position: fixed;
    inset: 0;
    margin: auto;
  }

  .lightbox::backdrop {
    background: rgba(29, 29, 31, 0.55);
  }

  .lightbox-img {
    display: block;
    width: 100%;
    max-height: calc(90vh - 120px);
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
  }

  .lightbox-caption {
    margin: var(--space-3) 0 0;
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .lightbox-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color var(--duration-normal) var(--ease-out),
                color var(--duration-normal) var(--ease-out);
  }

  .lightbox-close:hover {
    border-color: var(--color-celadon);
    color: var(--color-celadon);
  }

  .lightbox-close:focus-visible {
    outline: 2px solid var(--color-celadon);
    outline-offset: 2px;
  }

  /* Scroll lock without position:fixed on body -- preserves scroll
     position when the dialog opens and closes. */
  html:has(dialog.lightbox[open]) {
    overflow: hidden;
  }

  /* Motion: opt-in only. Reduced-motion users see the dialog appear
     instantly with no animation. */
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] {
      animation: lightbox-in var(--duration-normal) var(--ease-out);
    }
    .lightbox[open]::backdrop {
      animation: lightbox-backdrop-in var(--duration-normal) var(--ease-out);
    }
    @keyframes lightbox-in {
      from { opacity: 0; transform: scale(0.96); }
      to   { opacity: 1; transform: scale(1); }
    }
    @keyframes lightbox-backdrop-in {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('[data-animate="reveal"]').forEach((el) => {
    const element = el as HTMLElement;
    gsap.fromTo(element,
      { opacity: 0, y: 40 },
      {
        opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: element, start: 'top 85%', toggleActions: 'play none none none' },
      }
    );
  });

  // Description show-more / show-less toggle
  document.querySelectorAll<HTMLButtonElement>('[data-toggle-description]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const wrap = btn.closest('.description-clip') as HTMLElement | null;
      if (!wrap) return;
      const expanded = wrap.getAttribute('data-expanded') === 'true';
      wrap.setAttribute('data-expanded', String(!expanded));
      btn.setAttribute('aria-expanded', String(!expanded));
      const label = btn.querySelector('.description-toggle-label');
      if (label) label.textContent = !expanded ? 'Show less' : 'Show more';
    });
  });

  // Slide viewer — buttons + ArrowLeft/ArrowRight/Home/End when focused.
  // Eager-loads the next slide on each step so navigation feels instant.
  document.querySelectorAll<HTMLElement>('[data-slide-viewer]').forEach((viewer) => {
    const slides = Array.from(viewer.querySelectorAll<HTMLImageElement>('.slide-viewer-slide'));
    const counter = viewer.querySelector<HTMLElement>('[data-slide-counter]');
    const prevBtn = viewer.querySelector<HTMLButtonElement>('[data-slide-prev]');
    const nextBtn = viewer.querySelector<HTMLButtonElement>('[data-slide-next]');
    const total = slides.length;
    if (!total) return;
    let current = 0;

    const update = () => {
      slides.forEach((img, i) => img.classList.toggle('is-current', i === current));
      if (counter) counter.textContent = `${current + 1} / ${total}`;
      if (prevBtn) prevBtn.disabled = current === 0;
      if (nextBtn) nextBtn.disabled = current === total - 1;
      // Promote next/prev to eager so the immediate step is preloaded
      const neighbours = [slides[current + 1], slides[current - 1]];
      neighbours.forEach((img) => {
        if (img && img.loading === 'lazy') img.loading = 'eager';
      });
    };

    const goPrev = () => {
      if (current > 0) { current -= 1; update(); }
    };
    const goNext = () => {
      if (current < total - 1) { current += 1; update(); }
    };

    prevBtn?.addEventListener('click', goPrev);
    nextBtn?.addEventListener('click', goNext);

    viewer.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        goPrev();
      } else if (e.key === 'ArrowRight' || e.key === 'PageDown') {
        e.preventDefault();
        goNext();
      } else if (e.key === 'Home') {
        e.preventDefault();
        current = 0;
        update();
      } else if (e.key === 'End') {
        e.preventDefault();
        current = total - 1;
        update();
      }
    });

    // Click left half of the stage = prev, right half = next (mobile-friendly)
    const stage = viewer.querySelector<HTMLElement>('.slide-viewer-stage');
    stage?.addEventListener('click', (e: MouseEvent) => {
      const rect = stage.getBoundingClientRect();
      if (e.clientX - rect.left < rect.width / 2) goPrev();
      else goNext();
    });

    update();
  });

  // ── Lightbox: native <dialog>.showModal() driven by any [data-zoomable]
  //    trigger. Single delegated click handler. preventScroll on focus
  //    return keeps the in-page anchor / scroll position stable. Scroll
  //    lock handled in CSS via html:has(dialog[open]).
  const lightbox = document.querySelector<HTMLDialogElement>('#lightbox');
  if (lightbox) {
    const lbImg = lightbox.querySelector<HTMLImageElement>('.lightbox-img')!;
    const lbCap = lightbox.querySelector<HTMLParagraphElement>('#lightbox-caption')!;
    const lbClose = lightbox.querySelector<HTMLButtonElement>('.lightbox-close')!;
    let lastTrigger: HTMLElement | null = null;

    document.addEventListener('click', (e: MouseEvent) => {
      const trigger = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-zoomable]');
      if (!trigger) return;
      const img = trigger.querySelector('img');
      if (!img) return;
      lastTrigger = trigger;
      lbImg.src = img.currentSrc || img.src;
      lbImg.alt = img.alt;
      lbCap.textContent = img.alt;
      lightbox.showModal();
    });

    // Backdrop click closes (only when click target is dialog itself,
    // not bubbled from inside the image / caption / close button).
    lightbox.addEventListener('click', (e: MouseEvent) => {
      if (e.target === lightbox) lightbox.close();
    });

    lbClose.addEventListener('click', () => lightbox.close());

    // Restore focus to the figure that opened the lightbox; preventScroll
    // keeps the page from jumping if the figure is off-screen.
    lightbox.addEventListener('close', () => {
      lastTrigger?.focus({ preventScroll: true });
      lbImg.removeAttribute('src');
    });
  }
</script>
